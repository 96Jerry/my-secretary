# 앱
NODE_ENV=development
PORT=3000

# 데이터베이스 (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=my_secretary
DB_SYNCHRONIZE=false
DB_LOGGING=true

# Neon 등 외부 PostgreSQL 사용 시 true. 로컬 PostgreSQL이면 false.
DB_SSL=false

# Claude Agent SDK
# `claude setup-token` 명령으로 발급받은 OAuth 토큰을 입력
CLAUDE_CODE_OAUTH_TOKEN=
# Claude Code 실행 파일 경로. 로컬은 비워두면 SDK 번들 바이너리 자동 사용.
# 운영처럼 번들 바이너리 동작이 불안정한 환경에서만 명시 (`which claude`로 확인).
CLAUDE_CODE_PATH=
CLAUDE_MODEL=claude-opus-4-7

# 메일 (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM="My Secretary <your-email@gmail.com>"

# 일일 식단 수신자
MEAL_PLAN_RECIPIENT=your-email@gmail.com

# Cron (기본값: 매일 06:00)
MEAL_PLAN_CRON=0 6 * * *

# 동기부여 메시지 cron (기본값: 매일 06:00 Asia/Seoul)
MOTIVATION_CRON=0 6 * * *

# 저녁 수집 cron (기본값: 매일 22:00 Asia/Seoul)
EVENING_COLLECTION_CRON=0 22 * * *

# 팰월드 패치노트 알림 수신자
PALWORLD_NEWS_RECIPIENT=your-email@gmail.com

# 팰월드 패치노트 폴링 cron (기본값: 매일 09:00 Asia/Seoul)
PALWORLD_NEWS_CRON=0 9 * * *

# CGV 용산아이파크몰 IMAX 신규 회차 알림 수신자
CGV_IMAX_RECIPIENT=your-email@gmail.com

# 감시할 영화 제목 (쉼표 구분, 제목 일부만 적어도 됨)
# 국문/영문 모두 인식 — 한글 입력이 안 되는 터미널에서는 영문으로 적으면 된다
CGV_IMAX_MOVIES=Odyssey

# CGV IMAX 회차 폴링 cron (기본값: 1분마다)
CGV_IMAX_CRON=* * * * *

# Discord 봇
# 디스코드 개발자 포털에서 봇 생성 후 발급받은 토큰
# Bot 설정에서 "MESSAGE CONTENT INTENT"를 반드시 켤 것
DISCORD_BOT_TOKEN=

# 에러 알림 웹훅
# 채널 설정 → 연동 → 웹후크 에서 생성한 URL. 비워두면 알림 비활성.
DISCORD_ERROR_WEBHOOK_URL=

# NestJS Observe
# https://observe.nestjs.com 에서 발급받은 앱 키, 시크릿
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
