NODE_ENV=production

# 데이터베이스
DB_HOST=db
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=my_secretary
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Claude Agent SDK
# `claude setup-token` 명령으로 발급받은 OAuth 토큰을 입력
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_MODEL=claude-opus-4-7

# 메일 (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM="My Secretary <your-email@gmail.com>"

# 일일 식단 수신자
MEAL_PLAN_RECIPIENT=your-email@gmail.com

# cron 실행 여부 (개발 환경에서는 false로 두어 운영과 중복 실행을 막는다)
CRON_ENABLED=true

# Cron (기본값: 매일 06:00)
MEAL_PLAN_CRON=0 6 * * *

# 동기부여 메시지 cron (기본값: 매일 06:00 Asia/Seoul)
MOTIVATION_CRON=0 6 * * *

# 저녁 수집 cron (기본값: 매일 22:00 Asia/Seoul)
EVENING_COLLECTION_CRON=0 22 * * *

# 팰월드 패치노트 알림 수신자
PALWORLD_NEWS_RECIPIENT=your-email@gmail.com

# 팰월드 패치노트 폴링 cron (기본값: 매일 09:00 Asia/Seoul)
PALWORLD_NEWS_CRON=0 9 * * *

# CGV 용산아이파크몰 IMAX 신규 회차 알림 수신자
CGV_IMAX_RECIPIENT=your-email@gmail.com

# 감시할 영화 (쉼표 구분, `라벨:영화번호` 또는 `영화번호`)
# 라벨은 로그·메일 제목에만 쓴다. 영화번호는 CGV 예매 페이지에서 영화를 고를 때
# 주소·요청에 붙는 movNo 값이다 (예: 오디세이 = 30001323)
CGV_IMAX_MOVIES=오디세이:30001323

# CGV IMAX 회차 폴링 cron (기본값: 10분마다)
# 더 짧게 잡으면 Cloudflare가 서버 IP를 차단한다
CGV_IMAX_CRON=*/10 * * * *

# 네이버 웹툰 찜 순위 수집 cron (기본값: 매일 04:05 Asia/Seoul)
# CGV 폴링과 같은 IP를 쓰므로 매 10분 정각 직후는 피한다
WEBTOON_RANKING_CRON=5 4 * * *

# Discord 봇
# 디스코드 개발자 포털에서 봇 생성 후 발급받은 토큰
# Bot 설정에서 "MESSAGE CONTENT INTENT"를 반드시 켤 것
DISCORD_BOT_TOKEN=

# 게임 시간 기록 대상 디스코드 사용자 ID (설정 → 고급 → 개발자 모드 켠 뒤 프로필 우클릭 → ID 복사)
# 봇과 같은 서버에 있어야 하고, Bot 설정에서 "PRESENCE INTENT"를 먼저 켤 것. 비워두면 비활성.
DISCORD_GAME_USER_ID=

# 에러 알림 웹훅
# 채널 설정 → 연동 → 웹후크 에서 생성한 URL. 비워두면 알림 비활성.
DISCORD_ERROR_WEBHOOK_URL=
