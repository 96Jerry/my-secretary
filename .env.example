# 앱
NODE_ENV=development
PORT=3000

# 데이터베이스 (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=my_secretary
DB_SYNCHRONIZE=false
DB_LOGGING=true
# Neon 등 외부 PostgreSQL 사용 시 true. 로컬 PostgreSQL이면 false.
DB_SSL=false

# Claude Agent SDK
# `claude setup-token` 명령으로 발급받은 OAuth 토큰을 입력
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_MODEL=claude-opus-4-7

# 메일 (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM="My Secretary <your-email@gmail.com>"

# 일일 식단 수신자
MEAL_PLAN_RECIPIENT=your-email@gmail.com

# Cron (기본값: 매일 06:00)
MEAL_PLAN_CRON=0 6 * * *

# Discord 봇
# 디스코드 개발자 포털에서 봇 생성 후 발급받은 토큰
# Bot 설정에서 "MESSAGE CONTENT INTENT"를 반드시 켤 것
DISCORD_BOT_TOKEN=
