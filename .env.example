# 앱
NODE_ENV=development
PORT=3000

# 데이터베이스 (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=my_secretary
DB_SYNCHRONIZE=false
DB_LOGGING=true

# Claude Agent SDK
ANTHROPIC_API_KEY=sk-ant-xxx
CLAUDE_MODEL=claude-opus-4-7

# 메일 (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM="My Secretary <your-email@gmail.com>"

# 일일 식단 수신자
MEAL_PLAN_RECIPIENT=your-email@gmail.com

# Cron (기본값: 매일 06:00)
MEAL_PLAN_CRON=0 6 * * *
